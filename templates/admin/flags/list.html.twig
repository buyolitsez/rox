{% extends 'base.html.twig' %}
{% import 'macros.twig' as macros %}

{% block javascripts %}
  {{ encore_entry_script_tags('member/autocomplete') }}
{% endblock javascripts %}

{% block content %}
  <h1 class="u:text-24">
    {{ (member_first ? 'admin.flags.list.members' : 'admin.flags.list.flags')|trans }}
  </h1>

  <form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
      <label for="flags-member" class="form-label">{{ 'admin.flags.member'|trans }}</label>
      <input id="flags-member" name="member" value="{{ filters.member }}"
             class="form-control member-autocomplete-start">
    </div>
    <div class="col-12 col-md-3">
      <label for="flags-flag" class="form-label">{{ 'admin.flags.flag'|trans }}</label>
      <select id="flags-flag" name="flag" class="form-select">
        <option value=""></option>
        {% for flag in flags %}
          <option value="{{ flag.id }}"{% if filters.flag == flag.id %} selected{% endif %}>
            {{ flag.name }}
          </option>
        {% endfor %}
      </select>
    </div>
    <div class="col-8 col-md-3 form-check ms-2 mb-2">
      <input type="hidden" name="history" value="0">
      <input id="flags-history" name="history" value="1" type="checkbox"
             class="form-check-input"{% if filters.history %} checked{% endif %}>
      <label for="flags-history" class="form-check-label">{{ 'admin.flags.history'|trans }}</label>
    </div>
    <div class="col-4 col-md-1">
      <button class="o-button" type="submit">{{ 'admin.assignments.filter'|trans }}</button>
    </div>
  </form>

  {% if assignments.nbResults > 0 %}
    <div class="d-flex justify-content-end mb-2">{{ pagerfanta(assignments, 'rox_default') }}</div>
  {% endif %}

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>{{ (member_first ? 'admin.flags.member' : 'admin.flags.flag')|trans }}</th>
          <th>{{ (member_first ? 'admin.flags.flag' : 'admin.flags.member')|trans }}</th>
          <th>{{ 'admin.flags.level'|trans }}</th>
          <th>{{ 'admin.flags.scope'|trans }}</th>
          <th>{{ 'admin.flags.comment'|trans }}</th>
          <th>{{ 'admin.assignments.created'|trans }}</th>
          <th>{{ 'admin.assignments.updated'|trans }}</th>
          <th>{{ 'admin.assignments.actions'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {# Rows are ordered by the grouping key, so a group starts whenever the key changes. #}
        {% set group_key = member_first ? 'username' : 'definition_id' %}
        {% set rows = assignments.currentPageResults %}
        {% set previous_key = null %}
        {% for assignment in rows %}
          {% set member_cell %}
            <div class="d-flex align-items-start gap-2">
              {{ macros.avatar(assignment.username, 50, true) }}
              <div>
                <a href="{{ url('members_profile', {username: assignment.username}) }}">
                  {{ assignment.username }}
                </a>
                <div class="small">{{ assignment.status }}</div>
                <div class="small">
                  {{ assignment.last_active ? assignment.last_active|date('Y-m-d') : '—' }}
                </div>
                <div class="small">
                  {{ assignment.place_name|default('—') }}{% if assignment.country_name %}, {{ assignment.country_name }}{% endif %}
                </div>
                <a class="o-button o-button--s o-button--outline mt-1"
                   href="{{ url('admin_flags_assign_user', {username: assignment.username}) }}">
                  <i class="fa fa-plus-square me-1" aria-hidden="true"></i>{{ 'admin.flags.assign'|trans }}
                </a>
              </div>
            </div>
          {% endset %}
          {% set flag_cell %}
            <a href="{{ url('admin_flags_flag', {id: assignment.definition_id}) }}">
              {{ assignment.definition_name }}
            </a>
          {% endset %}
          <tr{% if assignment.level == 0 or assignment.superseded %} class="text-muted"{% endif %}>
            {% if assignment[group_key] != previous_key %}
              <td rowspan="{{ rows|filter(row => row[group_key] == assignment[group_key])|length }}" class="align-top">
                {{ member_first ? member_cell : flag_cell }}
              </td>
            {% endif %}
            <td>
              {{ member_first ? flag_cell : member_cell }}
              {% if assignment.superseded %}
                <span class="badge text-bg-secondary">{{ 'admin.flags.superseded'|trans }}</span>
              {% endif %}
            </td>
            <td>{{ assignment.level }}</td>
            <td>{{ assignment.scope }}</td>
            <td class="text-break">{{ assignment.comment|nl2br }}</td>
            <td>{{ assignment.created_at|date('Y-m-d H:i') }}</td>
            <td>{{ assignment.updated_at ? assignment.updated_at|date('Y-m-d H:i') : '—' }}</td>
            <td>
              {% if not assignment.superseded and assignment.level != 0 %}
                <div class="d-flex gap-1">
                  <a class="o-button o-button--s o-button--outline"
                     href="{{ url('admin_flags_edit', {id: assignment.definition_id, username: assignment.username}) }}"
                     aria-label="{{ 'admin.assignments.edit'|trans }}">
                    <i class="fa fa-edit" aria-hidden="true"></i>
                  </a>
                  <a class="o-button o-button--s o-button--outline"
                     href="{{ url('admin_flags_remove', {id: assignment.definition_id, username: assignment.username}) }}"
                     aria-label="{{ 'admin.assignments.remove'|trans }}">
                    <i class="fa fa-times" aria-hidden="true"></i>
                  </a>
                </div>
              {% endif %}
            </td>
          </tr>
          {% set previous_key = assignment[group_key] %}
        {% else %}
          <tr>
            <td colspan="8">{{ 'admin.assignments.none'|trans }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if assignments.nbResults > 0 %}
    <div class="d-flex justify-content-end">{{ pagerfanta(assignments, 'rox_default') }}</div>
  {% endif %}
{% endblock content %}
