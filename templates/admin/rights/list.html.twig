{% extends 'base.html.twig' %}
{% import 'macros.twig' as macros %}

{% block javascripts %}
  {{ encore_entry_script_tags('member/autocomplete') }}
{% endblock javascripts %}

{% block content %}
  <h1 class="u:text-24">
    {{ (member_first ? 'admin.rights.list.members' : 'admin.rights.list.rights')|trans }}
  </h1>

  <form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-12 col-md-4">
      <label for="rights-member" class="form-label">{{ 'admin.rights.member'|trans }}</label>
      <input id="rights-member" name="member" value="{{ filters.member }}"
             class="form-control member-autocomplete-start">
    </div>
    <div class="col-12 col-md-3">
      <label for="rights-right" class="form-label">{{ 'admin.rights.right'|trans }}</label>
      <select id="rights-right" name="right" class="form-select">
        <option value=""></option>
        {% for right in rights %}
          <option value="{{ right.id }}"{% if filters.right == right.id %} selected{% endif %}>
            {{ right.name }}
          </option>
        {% endfor %}
      </select>
    </div>
    {% if member_first %}
      <input type="hidden" name="history" value="1">
    {% else %}
      <div class="col-8 col-md-3 form-check ms-2 mb-2">
        <input type="hidden" name="history" value="0">
        <input id="rights-history" name="history" value="1" type="checkbox"
               class="form-check-input"{% if filters.history %} checked{% endif %}>
        <label for="rights-history" class="form-check-label">{{ 'admin.rights.history'|trans }}</label>
      </div>
    {% endif %}
    <div class="col-4 col-md-1">
      <button class="btn btn-primary" type="submit">{{ 'admin.assignments.filter'|trans }}</button>
    </div>
  </form>

  {% if assignments.nbResults > 0 %}
    <div class="d-flex justify-content-end mb-2">{{ pagerfanta(assignments, 'rox_default') }}</div>
  {% endif %}

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>{{ (member_first ? 'admin.rights.member' : 'admin.rights.right')|trans }}</th>
          <th>{{ (member_first ? 'admin.rights.right' : 'admin.rights.member')|trans }}</th>
          <th>{{ 'admin.rights.level'|trans }}</th>
          <th>{{ 'admin.rights.scope'|trans }}</th>
          <th>{{ 'admin.rights.comment'|trans }}</th>
          <th>{{ 'admin.assignments.created'|trans }}</th>
          <th>{{ 'admin.assignments.updated'|trans }}</th>
          <th>{{ 'admin.assignments.actions'|trans }}</th>
        </tr>
      </thead>
      <tbody>
        {# Rows are ordered by the grouping key, so a group starts whenever the key changes. #}
        {% set group_key = member_first ? 'username' : 'definition_id' %}
        {% set rows = assignments.currentPageResults %}
        {% set previous_key = null %}
        {% for assignment in rows %}
          {% set member_cell %}
            <div class="d-flex align-items-start gap-2">
              {{ macros.avatar(assignment.username, 50, true) }}
              <div>
                <a href="{{ url('members_profile', {username: assignment.username}) }}">
                  {{ assignment.username }}
                </a>
                <div class="small">{{ assignment.status }}</div>
                <div class="small">
                  {{ assignment.last_active ? assignment.last_active|date('Y-m-d') : '—' }}
                </div>
                <div class="small">
                  {{ assignment.place_name|default('—') }}{% if assignment.country_name %}, {{ assignment.country_name }}{% endif %}
                </div>
                <a class="btn btn-sm btn-outline-primary mt-1"
                   href="{{ url('admin_rights_assign', {username: assignment.username}) }}">
                  <i class="fa fa-plus-square me-1" aria-hidden="true"></i>{{ 'admin.rights.assign'|trans }}
                </a>
              </div>
            </div>
          {% endset %}
          {% set right_cell %}
            <a href="{{ url('admin_rights_right', {id: assignment.definition_id}) }}">
              {{ assignment.definition_name }}
            </a>
          {% endset %}
          <tr{% if assignment.level == 0 %} class="text-muted"{% endif %}>
            {% if assignment[group_key] != previous_key %}
              <td rowspan="{{ rows|filter(row => row[group_key] == assignment[group_key])|length }}" class="align-top">
                {{ member_first ? member_cell : right_cell }}
              </td>
            {% endif %}
            <td>{{ member_first ? right_cell : member_cell }}</td>
            <td>{{ assignment.level }}</td>
            <td>{{ assignment.scope }}</td>
            <td class="text-break">{{ assignment.comment|nl2br }}</td>
            <td>{{ assignment.created_at|date('Y-m-d H:i') }}</td>
            <td>{{ assignment.updated_at ? assignment.updated_at|date('Y-m-d H:i') : '—' }}</td>
            <td class="text-nowrap">
              <a class="btn btn-sm btn-outline-primary"
                 href="{{ url('admin_rights_edit', {id: assignment.definition_id, username: assignment.username}) }}"
                 aria-label="{{ 'admin.assignments.edit'|trans }}">
                <i class="fa fa-edit" aria-hidden="true"></i>
              </a>
              {% if assignment.level != 0 %}
                <a class="btn btn-sm btn-outline-danger"
                   href="{{ url('admin_rights_remove', {id: assignment.definition_id, username: assignment.username}) }}"
                   aria-label="{{ 'admin.assignments.remove'|trans }}">
                  <i class="fa fa-times" aria-hidden="true"></i>
                </a>
              {% endif %}
            </td>
          </tr>
          {% set previous_key = assignment[group_key] %}
        {% else %}
          <tr>
            <td colspan="8">{{ 'admin.assignments.none'|trans }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if assignments.nbResults > 0 %}
    <div class="d-flex justify-content-end">{{ pagerfanta(assignments, 'rox_default') }}</div>
  {% endif %}
{% endblock content %}
